# 复制本文件为 .env 后填写自己的配置（.env 已被 .gitignore 忽略，不会外泄）
# DeepSeek API Key：https://platform.deepseek.com/api_keys
# 不填也能用——只是「AI 生成例句 / 记忆法 / 知识图谱」会失效，手动加生词、背单词功能完全不受影响。
DEEPSEEK_API_KEY=

# 一般不需要改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 宿主机端口（如果 5000 被占用，改成 5001 等）
WORDNEST_PORT=5000

# Flask session 加密密钥，随便一串随机字符即可
SECRET_KEY=wordnest-local-secret-please-change

# 访问密码：留空=不启用（本机用）。
# 想让手机/外网访问时强烈建议设置，例如 WORDNEST_PASSWORD=my-strong-pass
# 设置后打开任何页面都会先跳到 /login，输入这个密码才能进。
WORDNEST_PASSWORD=

# 容器出网代理（可选）：宿主机开着 Clash / v2ray 等代理时，
# 容器直连 DeepSeek 会被掐断（报 SSL: UNEXPECTED_EOF_WHILE_READING），
# 填上代理端口即可，AI 功能会在"先代理、后直连"之间自动选择。
# Clash Verge 默认混合端口是 7897；代理没开时会自动回落直连。
WORDNEST_PROXY=http://host.docker.internal:7897

TZ=Asia/Shanghai
